{
  "name": "oopski",
  "version": "0.2.0",
  "description": "Chrome extension that shows the next step towards your goal on an unfamiliar website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --test && node test/session-flow.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
